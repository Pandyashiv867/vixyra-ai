# VIXYRA AI — copy to .env and fill in. Never commit .env.
# LLM (script + scene code + QA). OpenAI-compatible chat completions.
# Required for NEW topics. Without it, only the bundled template job can run.
# Pick ONE of the three options below (delete the others).
#
# Option A — Ollama, free, no key (recommended for laptop/self-hosted).
# Each machine runs its own model: no shared key, no shared token limit.
# Install Ollama, run `ollama pull qwen2.5:7b`, make sure `ollama serve`
# is running, then use these lines:
LLM_API_KEY=ollama
LLM_API_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5:7b
#
# Option B — Groq free tier (recommended for a hosted site).
# Free key at console.groq.com, no card. Fast, rate-limited, shared per key.
# LLM_API_KEY=gsk_your_key_here
# LLM_API_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
#
# Option C — OpenAI (paid, ~₹1 per video).
# LLM_API_KEY=<redacted>
# LLM_API_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
LLM_QA_MODEL=
# Paths (defaults work in this workspace; override on a fresh host)
FACELESS_SKILL=/home/hatch/workspace/custom-skills/faceless-shorts
# Chrome for headless rendering. Leave blank to auto-detect; in this sandbox
# the Hatch wrapper is needed — see scripts/setup.sh.
CHROME=/home/hatch/workspace/japan-trains-short/chrome-wrapper.sh
PORT=3000
HOST=127.0.0.1
